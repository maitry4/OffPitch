# ============================================================
# OffPitch Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp env.example .env
#
# Never commit .env to version control.
# Full Cloudinary guide: ../docs/cloudinary-songs.md
# ============================================================

# --- Database (Supabase PostgreSQL) --------------------------
# 1. Supabase project → Settings → Database
# 2. Copy the connection string (URI) / pooler URL
# 3. Prefix with "jdbc:" if needed
#
# Example:
#   JDBC_POSTGRES_URL=jdbc:postgresql://aws-0-....pooler.supabase.com:5432/postgres
#
JDBC_POSTGRES_URL=
DB_USERNAME=
DB_PASS=

# --- JPA / Hibernate ----------------------------------------
# Use "validate" in normal runs (Flyway owns schema).
JPA_DDL_AUTO=validate

# --- Google OAuth 2.0 ----------------------------------------
# Used when validating Google ID tokens (resource server).
# Same OAuth Web Client as the Next.js frontend.
#
# Redirect URI on the Google client (frontend):
#   http://localhost:3000/api/auth/callback/google
CLIENT_ID=

# --- Local karaoke audio (recommended for local/dev) ---------
# Serves MP3s from ../karaoke_songs via http://localhost:8080/media/...
# When set, this overrides Cloudinary URL building.
LOCAL_AUDIO_BASE_URL=http://localhost:8080/media
LOCAL_AUDIO_DIR=../karaoke_songs

# --- Cloudinary (optional CDN for deployed / multi-device) ----
# Lyrics JSON are NOT uploaded here.
# Lyrics are seeded into Postgres song_detail from:
#   backend/src/main/resources/songs/*.json
#
# Leave LOCAL_AUDIO_BASE_URL blank to use Cloudinary instead.
# 1. Upload MP3s with public_ids offpitch/songs/him-i_m (+ Gallan_Goodiyaan_m)
# 2. Confirm Copy URL plays in a browser tab
# 3. Restart backend
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=offpitch/songs
