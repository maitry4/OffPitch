# ============================================================
# OffPitch Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp env.example .env
#
# Never commit .env to version control.
# Full Cloudinary guide: ../docs/cloudinary-songs.md
# ============================================================

# --- Database (Supabase PostgreSQL) --------------------------
# 1. Supabase project → Settings → Database
# 2. Copy the connection string (URI) / pooler URL
# 3. Prefix with "jdbc:" if needed
#
# Example:
#   JDBC_POSTGRES_URL=jdbc:postgresql://aws-0-....pooler.supabase.com:5432/postgres
#
JDBC_POSTGRES_URL=
DB_USERNAME=
DB_PASS=

# --- JPA / Hibernate ----------------------------------------
# Use "validate" in normal runs (Flyway owns schema).
JPA_DDL_AUTO=validate

# --- Google OAuth 2.0 ----------------------------------------
# Used when validating Google ID tokens (resource server).
# Same OAuth Web Client as the Next.js frontend.
#
# Redirect URI on the Google client (frontend):
#   http://localhost:3000/api/auth/callback/google
CLIENT_ID=

# --- Cloudinary (karaoke MP3 CDN only) -----------------------
# Lyrics JSON are NOT uploaded here.
# Lyrics are seeded into Postgres song_detail from:
#   backend/src/main/resources/songs/*.json
#
# 1. https://cloudinary.com → Dashboard → copy Cloud name / API Key / API Secret
# 2. Media Library → create folder offpitch/songs
# 3. Upload ONLY the MP3s with these public_ids:
#      offpitch/songs/him-i_m
#      offpitch/songs/Gallan_Goodiyaan_m
# 4. Verify each asset → ⋯ → Copy URL opens/plays in browser
# 5. Restart backend
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=offpitch/songs
