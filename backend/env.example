# ============================================================
# OffPitch Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Database (Supabase PostgreSQL) --------------------------
# 1. Go to your Supabase project → Settings → Database
# 2. Copy the "Connection string" (URI format)
# 3. Prefix it with "jdbc:" and replace [YOUR-PASSWORD] with
#    your actual database password.
#
# Example:
#   JDBC_POSTGRES_URL=jdbc:postgresql://db.xxxxx.supabase.co:5432/postgres
#
JDBC_POSTGRES_URL=

# Your Supabase database password (set during project creation)
DB_PASS=

# --- JPA / Hibernate ----------------------------------------
# Controls how Hibernate handles schema on startup.
# Options: none | validate | update | create | create-drop
# Use "validate" in production (let Flyway handle migrations).
# Use "update" only during early prototyping.
JPA_DDL_AUTO=validate

# --- Google OAuth 2.0 ----------------------------------------
# 1. Go to https://console.cloud.google.com
# 2. Create a new project (or select an existing one).
# 3. Navigate to "APIs & Services" → "Credentials".
# 4. Click "Create Credentials" → "OAuth client ID".
# 5. Choose application type: "Web application".
# 6. Under "Authorized redirect URIs", add:
#      http://localhost:3000/api/auth/callback/google
# 7. Copy the generated Client ID and Client Secret below.
CLIENT_ID=